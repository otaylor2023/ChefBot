# Nothing in this project reads this file on its own. Two ways to provide a key:
#   1) export OPENAI_API_KEY=...            (current shell only)
#   2) cp .env.example .env, fill it in, then: uv run --env-file .env python run_recipe.py ...
# .env is git-ignored and is never copied, logged or written into run folders.
OPENAI_API_KEY=
